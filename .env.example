# Copy to .env and fill in. Never commit real values.

# Postgres connection string (Supabase: use the transaction pooler URL).
DATABASE_URL=

# Optional: also run packages/core's round-trip test against a real database.
TEST_DATABASE_URL=

# Shopify Admin API version used by the live order fetch.
SHOPIFY_API_VERSION=2026-10

# Optional: a development store and custom app token (read_orders) for the
# attribution CLI's --shop and --token flags.
SHOPIFY_SHOP=
SHOPIFY_TOKEN=

# apps/web live mode: show this shop's latest stored report.
# There is no authentication in live mode. Set it locally only.
CENTURION_SHOP=

# apps/gateway: HMAC key for the evidence log. Required in any shared environment.
EVIDENCE_SECRET=
