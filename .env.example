# Copy to .env and fill in. Never commit real values.

# Postgres connection string. Supabase: the transaction pooler URL works for apps/web and the
# CLIs; apps/shopify also runs Prisma migrations for its sessions, so there use the direct
# connection or the session pooler (port 5432).
DATABASE_URL=

# Optional: also run packages/core's round-trip test against a real database.
TEST_DATABASE_URL=

# Shopify Admin API version used by the live order fetch.
SHOPIFY_API_VERSION=2026-10

# Optional: live store access for the attribution CLI. SHOPIFY_SHOP is the store
# handle (your-store) or domain (your-store.myshopify.com). The client ID and
# secret come from a Dev Dashboard app with the read_orders scope, in the same
# Shopify organization as the store and installed on it. They are exchanged for
# short-lived Admin API tokens with the client credentials grant.
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Meta Model API (Muse Spark) for AI Answer Check. Set the key and Answer Check calls Meta live;
# leave it empty and both apps show labeled fixture answers instead. Model (default muse-spark-1.3)
# and base URL (default https://api.meta.ai/v1) are optional.
META_API_KEY=
META_MODEL=
META_API_BASE_URL=

# Weekly Fix: apply and undo change live product descriptions only when this is "on" (also needs write_products).
CENTURION_STORE_WRITES=

# apps/web live mode: show this shop's latest stored report.
# There is no authentication in live mode. Set it locally only.
CENTURION_SHOP=

# apps/gateway: HMAC key for the evidence log. Required in any shared environment.
EVIDENCE_SECRET=
