{
  "name": "@centurion/checkout-test",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Checkout Test: a browser agent that shops a storefront up to checkout, never pays, and records a video and a step log.",
  "type": "module",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
