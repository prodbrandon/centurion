    "check": "tsx src/cli.ts"
  },
  "engines": { "node": ">=22.12" },
  "dependencies": {
    "@centurion/core": "file:../core",
    "playwright": "1.63.0",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
