{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16", "lib": ["ES2022"],
    "noEmit": true, "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "allowImportingTsExtensions": true
  },
  "include": ["src/**/*"]
}
