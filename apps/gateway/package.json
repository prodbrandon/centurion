{
  "name": "@centurion/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-facing MCP server that serves a brand's rulebook: verified facts, claim checks, tiered offers, policies, order status, returns and wholesale quotes, with a signed evidence log.",
  "type": "module",
  "bin": { "centurion-gateway": "dist/index.js" },
  "files": ["dist", "data"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "engines": { "node": ">=20.3" },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
